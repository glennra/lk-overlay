include project/rpi3-vpu-stage2.mk

ifeq ($(strip $(ARM_CHAINLOADER_BIN)),)
$(error Set ARM_CHAINLOADER_BIN to the absolute path of the ARM chainloader binary)
endif
ARM_CHAINLOADER_BIN := $(abspath $(ARM_CHAINLOADER_BIN))
ifeq ($(wildcard $(ARM_CHAINLOADER_BIN)),)
$(error ARM_CHAINLOADER_BIN does not exist: $(ARM_CHAINLOADER_BIN))
endif

MODULES += platform/bcm28xx/arm-chainloader
DISPLAY_BACKEND := DSI
GLOBAL_DEFINES += DISPLAY_BACKEND_DSI=1
GLOBAL_DEFINES += BCM283X_ARM_CHAINLOADER=1
DSI_USB_PHY_PREFLIGHT ?= 0
GLOBAL_DEFINES += DSI_USB_PHY_PREFLIGHT=$(DSI_USB_PHY_PREFLIGHT)
ifeq ($(DSI_USB_PHY_PREFLIGHT),1)
MODULES += platform/bcm28xx/usb-phy
endif
DSI_USB_POWER_PREFLIGHT ?= 0
GLOBAL_DEFINES += DSI_USB_POWER_PREFLIGHT=$(DSI_USB_POWER_PREFLIGHT)
DSI_STATIC_HANDOFF ?= 0
GLOBAL_DEFINES += DSI_STATIC_HANDOFF=$(DSI_STATIC_HANDOFF)
DSI_BOOT_TIMING ?= 0
GLOBAL_DEFINES += DSI_BOOT_TIMING=$(DSI_BOOT_TIMING)
DSI_GPIO_TIMING ?= $(DSI_BOOT_TIMING)
GLOBAL_DEFINES += DSI_GPIO_TIMING=$(DSI_GPIO_TIMING)
DSI_FIRST_FRAME_SETTLE_US ?= 49000
GLOBAL_DEFINES += DSI_FIRST_FRAME_SETTLE_US=$(DSI_FIRST_FRAME_SETTLE_US)
DSI_PANEL_DELAY_SCALE_PCT ?= 100
GLOBAL_DEFINES += DSI_PANEL_DELAY_SCALE_PCT=$(DSI_PANEL_DELAY_SCALE_PCT)
WITH_MATRIX_BOOT_ANIMATION ?= 0
GLOBAL_DEFINES += WITH_MATRIX_BOOT_ANIMATION=$(WITH_MATRIX_BOOT_ANIMATION)
